generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== ROLES & PERMISSIONS ====================

// Конкретное право — "users.create", "roles.edit", etc.
model Permission {
  id          String   @id @default(uuid())
  name        String   // "Создание пользователей"
  slug        String   @unique // "users.create", "users.delete"
  group       String   // "users", "roles", "audit", "files" — для группировки в UI
  description String?
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]

  @@map("permissions")
}

// Роль — набор прав, назначается юзеру напрямую
model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  permissions RolePermission[]
  users       User[]

  @@map("roles")
}

// Связь Role <-> Permission (many-to-many)
model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ==================== USERS ====================

model User {
  id         String  @id @default(uuid())
  email      String  @unique
  password   String
  firstName  String
  lastName   String
  middleName String?

  isActive Boolean   @default(true)
  isOnline Boolean   @default(false)
  lastSeen DateTime?

  // Роль пользователя (напрямую)
  roleId String?
  role   Role?  @relation(fields: [roleId], references: [id])

  // Профиль торгового
  tradeCode         String?   @unique
  firstTripDate     DateTime?
  isCoordinator     Boolean   @default(false)
  coordinatorId     String?
  coordinator       User?     @relation("CoordinatorSubordinates", fields: [coordinatorId], references: [id])
  subordinates      User[]    @relation("CoordinatorSubordinates")

  // Лимит одновременных сессий
  maxSessions Int @default(1)

  // Личные данные
  birthDate         DateTime?
  isMarried         Boolean?
  hasChildren       Boolean?
  hasPassport       Boolean?
  hasDriverLicense  Boolean?
  drivingExperience Float?
  comment           String?   @db.VarChar(500)
  passportNumber    String?
  registrationAddress String?
  livingAddress     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts            UserContact[]
  languages           UserLanguage[]
  citizenships        UserCitizenship[]
  documents           UserDocument[]
  sessions            Session[]
  auditLogs           AuditLog[]

  // Trip relations
  tripsCoordinated       Trip[]             @relation("TripCoordinator")
  tripsCreated           Trip[]             @relation("TripCreatedBy")
  tripCrewMembers        TripCrew[]
  presentationsCoordinated Presentation[]   @relation("PresentationCoordinator")
  presentationsCreated     Presentation[]   @relation("PresentationCreatedBy")
  presentationCrewMembers  PresentationCrew[]
  presentationSummaryRows  PresentationSummary[]

  // Warehouse relations
  personalWarehouses  Warehouse[]   @relation("PersonalWarehouse")
  warehousesCreated   Warehouse[]   @relation("WarehouseCreator")
  transactions        Transaction[]

  // Wallet relations
  personalWallets     Wallet[]      @relation("PersonalWallet")
  walletsCreated      Wallet[]      @relation("WalletCreator")
  walletTxsCreated    WalletTx[]    @relation("WalletTxCreatedBy")
  walletTxsClosed     WalletTx[]    @relation("WalletTxClosedBy")

  // Guest lists relations
  guestListsCreated      GuestList[]      @relation("GuestListCreatedBy")
  guestImportLogsCreated GuestImportLog[] @relation("GuestImportLogCreatedBy")

  // Contract relations
  contractsSpeaker    Contract[] @relation("ContractSpeaker")
  contractsSignedBy   Contract[] @relation("ContractSignedBy")
  contractsCreated    Contract[] @relation("ContractCreatedBy")
  contractFilesUploaded ContractFile[] @relation("ContractFileUploadedBy")

  @@map("users")
}

// ==================== USER CONTACTS ====================

enum ContactType {
  MOBILE
  WHATSAPP
  TELEGRAM
}

model UserContact {
  id          String      @id @default(uuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        ContactType
  countryCode String      // "+998", "+7"
  phone       String      // номер без кода страны
  createdAt   DateTime    @default(now())

  @@map("user_contacts")
}

// ==================== USER LANGUAGES ====================

enum LanguageLevel {
  BEGINNER
  ELEMENTARY
  INTERMEDIATE
  UPPER_INTERMEDIATE
  ADVANCED
  NATIVE
}

model UserLanguage {
  id       String        @id @default(uuid())
  userId   String
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  language String
  level    LanguageLevel

  @@unique([userId, language])
  @@map("user_languages")
}

// ==================== USER CITIZENSHIPS ====================

model UserCitizenship {
  id      String @id @default(uuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  country String

  @@unique([userId, country])
  @@map("user_citizenships")
}

// ==================== DOCUMENTS ====================

model UserDocument {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  fileName    String
  filePath    String
  fileSize    Int
  mimeType    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("user_documents")
}

// ==================== SESSIONS ====================

model Session {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken String   @unique
  rememberMe   Boolean  @default(false)
  ip           String?
  userAgent    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@map("sessions")
}

// ==================== TRIPS ====================

enum TripStatus {
  PLANNED
  ACTIVE
  CLOSED
}

enum PresentationStatus {
  PLANNED
  COMPLETED
  CANCELLED
}

enum TripRole {
  LEADER
  MV
  GA
  MV_GA
  TRADER
}

enum PaymentType {
  CASH
  CREDIT
  COMPANY
  MIXED
  TERMINAL
  RESERVATION
}

enum SaleType {
  RAFFLE
  HOURLY
}

enum ContractStatus {
  UNVERIFIED
  VERIFIED
  CANCELLED
}

enum PaymentStatus {
  OPEN            // Незакрытый (рассрочка не выплачена)
  CLOSED          // Закрытый (авансы = сумме или рассрочка выплачена)
  REFUND          // Возврат (авансы обнулены)
  PARTIAL_REFUND  // Частичный возврат
}

model Trip {
  id              String     @id @default(uuid())
  name            String     // "AA250226" — авто: teamName + format(startDate)
  teamName        String     // название команды, напр. "AA"
  startDate       DateTime
  endDate         DateTime
  status          TripStatus @default(PLANNED)

  coordinatorId   String?
  coordinator     User?      @relation("TripCoordinator", fields: [coordinatorId], references: [id])

  createdById     String
  createdBy       User       @relation("TripCreatedBy", fields: [createdById], references: [id])

  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  crew            TripCrew[]
  presentations   Presentation[]
  warehouse       Warehouse?
  wallet          Wallet?
  guestLists      GuestList[]
  importLogs      GuestImportLog[]
  tripBanks       TripBank[]
  tripCompanies   TripCompany[]
  contracts       Contract[]

  @@map("trips")
}

model TripCrew {
  id      String   @id @default(uuid())
  tripId  String
  trip    Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  userId  String
  user    User     @relation(fields: [userId], references: [id])
  role    TripRole

  @@unique([tripId, userId])
  @@map("trip_crew")
}

// ==================== PRESENTATIONS ====================

model Presentation {
  id              String             @id @default(uuid())
  tripId          String
  trip            Trip               @relation(fields: [tripId], references: [id], onDelete: Cascade)
  name            String             // авто: "AA 23.02 #1"
  date            DateTime
  time            String             // "08:00"
  number          Int                // 1 / 2 / 3 по слоту времени
  status          PresentationStatus @default(PLANNED)

  typeId          String?
  type            PresentationType?  @relation(fields: [typeId], references: [id])

  venueId         String?
  venue           Venue?             @relation(fields: [venueId], references: [id])

  coordinatorId   String?
  coordinator     User?              @relation("PresentationCoordinator", fields: [coordinatorId], references: [id])

  createdById     String?
  createdBy       User?              @relation("PresentationCreatedBy", fields: [createdById], references: [id])

  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  crew            PresentationCrew[]
  summaryRows     PresentationSummary[]
  guestRecords    GuestRecord[]
  contracts       Contract[]

  @@map("presentations")
}

model PresentationCrew {
  id              String       @id @default(uuid())
  presentationId  String
  presentation    Presentation @relation(fields: [presentationId], references: [id], onDelete: Cascade)
  userId          String
  user            User         @relation(fields: [userId], references: [id])
  role            TripRole

  @@unique([presentationId, userId])
  @@map("presentation_crew")
}

model PresentationSummary {
  id             String       @id @default(uuid())
  presentationId String
  presentation   Presentation @relation(fields: [presentationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id])

  successApproach Int? // Успешных Часовка
  totalApproach   Int? // Всех (каждых) Часовка
  refusalCount    Int? // Количество отказов
  refusalValue    Int? // Значение отказа
  rewriteCount    Int? // Количество переписанных
  rewriteValue    Int? // Ценность переписанных

  updatedAt DateTime @updatedAt

  @@unique([presentationId, userId])
  @@map("presentation_summary")
}

// ==================== DIRECTORIES ====================

model PresentationType {
  id          String   @id @default(uuid())
  name        String   @unique
  letter      String?  // Буква для номера договора (П, Р, С и т.д.)
  description String?
  createdAt   DateTime @default(now())

  presentations Presentation[]

  @@map("presentation_types")
}

model Venue {
  id        String   @id @default(uuid())
  city      String
  address   String
  venueName String
  createdAt DateTime @default(now())

  presentations Presentation[]

  @@unique([city, address, venueName])
  @@map("venues")
}

model Bank {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  tripBanks     TripBank[]
  contractBanks ContractBank[]
  conditions    BankCondition[]

  @@map("banks")
}

model BankCondition {
  id        String   @id @default(uuid())
  bankId    String
  name      String   // "24 месяца"
  rate      Decimal  @db.Decimal(5, 2)  // 33.5
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  bank          Bank          @relation(fields: [bankId], references: [id], onDelete: Cascade)
  contractBanks ContractBank[]

  @@map("bank_conditions")
}

model TripBank {
  id     String @id @default(uuid())
  tripId String
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  bankId String
  bank   Bank   @relation(fields: [bankId], references: [id], onDelete: Cascade)

  @@unique([tripId, bankId])
  @@map("trip_banks")
}

model Company {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  tripCompanies TripCompany[]
  contracts     Contract[]

  @@map("companies")
}

model TripCompany {
  id        String  @id @default(uuid())
  tripId    String
  trip      Trip    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([tripId, companyId])
  @@map("trip_companies")
}

// ==================== WAREHOUSE & WALLET ====================

enum WarehouseType {
  CENTRAL
  PERSONAL
  TRIP
}

enum TransactionType {
  INCOMING
  SALE
  GIFT
  CONTRACT
  WRITE_OFF
  TRANSFER_OUT
  TRANSFER_IN
  REVERSAL     // Сторно (обратная транзакция)
}

// Источник прихода (только для INCOMING)
enum IncomeSource {
  SUPPLIER  // Поставщик
  SPV       // СПВ (специалист по возвратам)
}

enum TransferStatus {
  PENDING
  COMPLETED
  CANCELLED
}

model Warehouse {
  id          String        @id @default(uuid())
  name        String
  type        WarehouseType
  tripId      String?       @unique
  ownerId     String?
  createdById String
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())

  trip        Trip?         @relation(fields: [tripId], references: [id], onDelete: Cascade)
  owner       User?         @relation("PersonalWarehouse", fields: [ownerId], references: [id])
  createdBy   User          @relation("WarehouseCreator", fields: [createdById], references: [id])
  stock       Stock[]
  outgoing    Transaction[] @relation("FromWarehouse")
  incoming    Transaction[] @relation("ToWarehouse")

  @@map("warehouses")
}

model Product {
  id        String   @id @default(uuid())
  name      String
  unit      String
  sku       String?  @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  stock            Stock[]
  transactionItems TransactionItem[]
  contractItems    ContractItem[]

  @@map("products")
}

model Stock {
  id          String    @id @default(uuid())
  warehouseId String
  productId   String
  quantity    Decimal   @default(0) @db.Decimal(12, 3)

  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id])

  @@unique([warehouseId, productId])
  @@map("stock")
}

model Transaction {
  id              String          @id @default(uuid())
  type            TransactionType
  fromWarehouseId String?
  toWarehouseId   String?
  source          IncomeSource?   // только для INCOMING
  note            String?
  pairId          String?
  transferStatus  TransferStatus?
  reversalOfId    String?         @unique // ссылка на исходную транзакцию (для сторно)
  createdById     String
  createdAt       DateTime        @default(now())

  fromWarehouse   Warehouse?      @relation("FromWarehouse", fields: [fromWarehouseId], references: [id])
  toWarehouse     Warehouse?      @relation("ToWarehouse", fields: [toWarehouseId], references: [id])
  createdBy       User            @relation(fields: [createdById], references: [id])
  items           TransactionItem[]
  reversalOf      Transaction?    @relation("TransactionReversal", fields: [reversalOfId], references: [id])
  reversedBy      Transaction?    @relation("TransactionReversal")
  contractItem    ContractItem?

  @@index([fromWarehouseId])
  @@index([toWarehouseId])
  @@index([pairId])
  @@index([transferStatus])
  @@index([createdAt])
  @@map("transactions")
}

model TransactionItem {
  id            String      @id @default(uuid())
  transactionId String
  productId     String
  quantity      Decimal     @db.Decimal(12, 3)

  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  product       Product     @relation(fields: [productId], references: [id])

  @@map("transaction_items")
}

// ==================== WALLETS ====================

enum WalletType {
  TRIP
  PERSONAL
}

enum WalletTxType {
  INCOME       // Приход средств
  EXPENSE      // Расход средств
  TRANSFER_OUT // Исходящий перевод
  TRANSFER_IN  // Входящий перевод
  CONVERSION   // Конвертация валюты
  REVERSAL     // Сторно (обратная транзакция)
}

model Wallet {
  id          String     @id @default(uuid())
  type        WalletType
  name        String?    // для PERSONAL — имя кошелька

  // для PERSONAL: владелец
  ownerId     String?
  owner       User?      @relation("PersonalWallet", fields: [ownerId], references: [id])

  // для TRIP: связь с выездом (1:1)
  tripId      String?    @unique
  trip        Trip?      @relation(fields: [tripId], references: [id], onDelete: Cascade)

  isBlocked   Boolean    @default(false)

  createdById String
  createdBy   User       @relation("WalletCreator", fields: [createdById], references: [id])

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  balances     WalletBalance[]
  transactions WalletTx[]
  transfersOut WalletTransfer[] @relation("WalletTransferFrom")
  transfersIn  WalletTransfer[] @relation("WalletTransferTo")

  @@map("wallets")
}

// Баланс кошелька в конкретной валюте
model WalletBalance {
  id       String  @id @default(uuid())
  walletId String
  wallet   Wallet  @relation(fields: [walletId], references: [id], onDelete: Cascade)
  currency String  // ISO 4217: "USD", "RUB", "UZS" и т.д.
  amount   Decimal @default(0) @db.Decimal(18, 4)

  @@unique([walletId, currency])
  @@map("wallet_balances")
}

// Статус перевода между кошельками
enum WalletTransferStatus {
  PENDING    // ожидает подтверждения получателем
  COMPLETED  // подтверждён
  CANCELLED  // отменён отправителем
}

// Транзакция в кошельке
model WalletTx {
  id           String       @id @default(uuid())
  walletId     String
  wallet       Wallet       @relation(fields: [walletId], references: [id])
  type         WalletTxType

  currency     String    // основная валюта транзакции
  amount       Decimal   @db.Decimal(18, 4)

  // Для CONVERSION: целевая валюта и сумма
  toCurrency   String?
  toAmount     Decimal?  @db.Decimal(18, 4)
  rate         Decimal?  @db.Decimal(18, 6) // курс обмена
  isCustomRate Boolean   @default(false)    // пользовательский курс

  // Для INCOME: тип расхода из справочника
  expenseTypeId String?
  expenseType   ExpenseType? @relation(fields: [expenseTypeId], references: [id])

  description  String?

  // Закрытие транзакции (только аудитор)
  isClosed     Boolean   @default(false)
  closedAt     DateTime?
  closedById   String?
  closedBy     User?     @relation("WalletTxClosedBy", fields: [closedById], references: [id])

  // Сторно: ссылка на исходную транзакцию
  reversalOfId String?   @unique
  reversalOf   WalletTx? @relation("WalletTxReversal", fields: [reversalOfId], references: [id])
  reversedBy   WalletTx? @relation("WalletTxReversal")

  createdById  String
  createdBy    User      @relation("WalletTxCreatedBy", fields: [createdById], references: [id])

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  images      WalletTxImage[]
  transferOut WalletTransfer? @relation("WalletTransferOutTx")
  transferIn  WalletTransfer? @relation("WalletTransferInTx")

  @@map("wallet_txs")
}

// Фото к транзакции (до 15 штук)
model WalletTxImage {
  id        String   @id @default(uuid())
  txId      String
  tx        WalletTx @relation(fields: [txId], references: [id], onDelete: Cascade)
  url       String
  filename  String?
  createdAt DateTime @default(now())

  @@map("wallet_tx_images")
}

// Перевод между кошельками (связывает две транзакции)
model WalletTransfer {
  id           String               @id @default(uuid())
  fromWalletId String
  fromWallet   Wallet               @relation("WalletTransferFrom", fields: [fromWalletId], references: [id])
  toWalletId   String
  toWallet     Wallet               @relation("WalletTransferTo", fields: [toWalletId], references: [id])

  outTxId      String               @unique
  outTx        WalletTx             @relation("WalletTransferOutTx", fields: [outTxId], references: [id])
  inTxId       String?              @unique // null пока перевод PENDING
  inTx         WalletTx?            @relation("WalletTransferInTx", fields: [inTxId], references: [id])

  currency     String
  amount       Decimal              @db.Decimal(18, 4)
  status       WalletTransferStatus @default(PENDING)

  createdAt    DateTime             @default(now())

  @@map("wallet_transfers")
}

// Тип расхода (справочник)
model ExpenseType {
  id        String    @id @default(uuid())
  name      String    @unique
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  walletTxs WalletTx[]

  @@map("expense_types")
}

// ==================== GUEST LISTS ====================

// Список гостей — один батч импорта, привязан к выезду и конкретной дате
model GuestList {
  id              String          @id @default(uuid())
  tripId          String
  trip            Trip            @relation(fields: [tripId], references: [id], onDelete: Cascade)
  date            String          // "YYYY-MM-DD" — выбранная дата при импорте
  fileName        String          // оригинальное имя csv-файла
  totalCount      Int             @default(0)   // всего строк в файле (без дублей внутри файла)
  importedCount   Int             @default(0)   // успешно импортировано
  failedCount     Int             @default(0)   // не прошло валидацию
  duplicatesCount Int             @default(0)   // дублей по телефону внутри файла
  guests          GuestRecord[]
  logs            GuestImportLog[]
  createdAt       DateTime        @default(now())
  createdById     String
  createdBy       User            @relation("GuestListCreatedBy", fields: [createdById], references: [id])

  @@map("guest_lists")
}

// Запись одного гостя в списке
model GuestRecord {
  id                 String       @id @default(uuid())
  guestListId        String
  guestList          GuestList    @relation(fields: [guestListId], references: [id], onDelete: Cascade)
  presentationId     String
  presentation       Presentation @relation(fields: [presentationId], references: [id])

  // ── Основные поля из CSV ───────────────────────────────────────────────────
  fullName           String?      // ФИО
  couponNumber       String?      // № купона
  phone              String       // Телефон 1
  phone2             String?      // Телефон 2
  phone3             String?      // Телефон 3

  // ── Числовые характеристики ────────────────────────────────────────────────
  guestsCount        Int?         // Гости (0 = один, 1 = пришёл с одним доп. гостем)
  pairsCount         Int?         // Пары
  passportCount      Int?         // Паспорт
  age                Int?         // Возраст

  // ── Дополнительная информация ─────────────────────────────────────────────
  insteadOf          String?      // Вместо
  guestFullName      String?      // ФИО Гостя
  guestPhone         String?      // Телефон Гостя

  // ── Статус на презентации ─────────────────────────────────────────────────
  leftStatus         String?      // "не пустили" | "ушел"
  leftReason         String?      // Причина (из справочника)
  notes              String?      @db.VarChar(150) // Заметки до 150 символов

  // ── Привязка к слоту ──────────────────────────────────────────────────────
  presentationNumber Int?         // 1 / 2 / 3 — номер презентации
  time               String?      // Время (по дефолту из CSV, меняется при смене слота)

  createdAt          DateTime     @default(now())

  @@map("guest_records")
}

// Лог каждой операции импорта или удаления-по-файлу
model GuestImportLog {
  id              String     @id @default(uuid())
  tripId          String
  trip            Trip       @relation(fields: [tripId], references: [id], onDelete: Cascade)
  guestListId     String?
  guestList       GuestList? @relation(fields: [guestListId], references: [id], onDelete: SetNull)
  action          String     // 'IMPORT' | 'DELETE_BY_FILE'
  fileName        String
  totalCount      Int
  importedCount   Int
  failedCount     Int
  duplicatesCount Int        @default(0)
  createdAt       DateTime   @default(now())
  createdById     String
  createdBy       User       @relation("GuestImportLogCreatedBy", fields: [createdById], references: [id])

  @@map("guest_import_logs")
}

// ==================== CONTRACTS ====================

model Contract {
  id             String         @id @default(uuid())
  contractNumber String         @unique // "210326/1П-001"

  clientName     String
  contractDate   DateTime

  companyId      String?
  company        Company?       @relation(fields: [companyId], references: [id])

  paymentType    PaymentType
  saleType       SaleType?

  presentationId String
  presentation   Presentation   @relation(fields: [presentationId], references: [id])

  tripId         String
  trip           Trip           @relation(fields: [tripId], references: [id])

  speakerId      String?
  speaker        User?          @relation("ContractSpeaker", fields: [speakerId], references: [id])

  signedById     String
  signedBy       User           @relation("ContractSignedBy", fields: [signedById], references: [id])

  createdById    String
  createdBy      User           @relation("ContractCreatedBy", fields: [createdById], references: [id])

  totalAmount    Decimal        @default(0) @db.Decimal(12, 2)
  advanceCash    Decimal?       @db.Decimal(12, 2)
  advanceTerminal Decimal?      @db.Decimal(12, 2)
  advanceBank    Decimal?       @db.Decimal(12, 2)

  installmentMonths  Int?
  firstPaymentDate   DateTime?

  registrationAddress String?
  actualAddress       String?

  status         ContractStatus @default(UNVERIFIED)
  paymentStatus  PaymentStatus  @default(OPEN)

  // Суммы до/после возврата
  amountAfterRefund Decimal?    @db.Decimal(12, 2)

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  banks            ContractBank[]
  phones           ContractPhone[]
  paymentSchedule  ContractPaymentSchedule[]
  files            ContractFile[]
  contractItems    ContractItem[]

  @@map("contracts")
}

model ContractFile {
  id           String   @id @default(uuid())
  contractId   String
  contract     Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  fileName     String   // оригинальное имя файла
  filePath     String   // путь на диске
  fileSize     Int
  mimeType     String
  uploadedById String?
  uploadedBy   User?    @relation("ContractFileUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  @@map("contract_files")
}

model ContractBank {
  id            String   @id @default(uuid())
  contractId    String
  contract      Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  bankId        String
  bank          Bank     @relation(fields: [bankId], references: [id])
  advance       Decimal? @db.Decimal(14, 2)
  conditionId   String?
  conditionName String?        // снимок названия условия
  conditionRate Decimal?       @db.Decimal(5, 2)  // снимок процента

  condition     BankCondition? @relation(fields: [conditionId], references: [id], onDelete: SetNull)

  @@unique([contractId, bankId])
  @@map("contract_banks")
}

model ContractPhone {
  id          String   @id @default(uuid())
  contractId  String
  contract    Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  countryCode String   // "+7", "+998"
  number      String   // номер без кода страны
  order       Int      @default(0)

  @@map("contract_phones")
}

model ContractPaymentSchedule {
  id         String   @id @default(uuid())
  contractId String
  contract   Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  date       DateTime
  amount     Decimal  @db.Decimal(12, 2)
  isPaid     Boolean  @default(false)
  order      Int      @default(0)

  @@map("contract_payment_schedules")
}

model ContractItem {
  id            String          @id @default(uuid())
  contractId    String
  contract      Contract        @relation(fields: [contractId], references: [id], onDelete: Cascade)
  productId     String
  product       Product         @relation(fields: [productId], references: [id])
  quantity      Decimal         @db.Decimal(12, 3)
  type          TransactionType // SALE или GIFT
  transactionId String?         @unique
  transaction   Transaction?    @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  createdAt     DateTime        @default(now())

  @@map("contract_items")
}

// ==================== AUDIT LOG ====================

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String   // "user.created", "role.updated"
  entity    String   // "user", "role", "permission"
  entityId  String?
  details   Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}
