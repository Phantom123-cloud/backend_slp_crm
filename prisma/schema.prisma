generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== ROLES & PERMISSIONS ====================

// Конкретное право — "users.create", "roles.edit", etc.
model Permission {
  id          String   @id @default(uuid())
  name        String   // "Создание пользователей"
  slug        String   @unique // "users.create", "users.delete"
  group       String   // "users", "roles", "audit", "files" — для группировки в UI
  description String?
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]

  @@map("permissions")
}

// Роль — набор прав, назначается юзеру напрямую
model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  permissions RolePermission[]
  users       User[]

  @@map("roles")
}

// Связь Role <-> Permission (many-to-many)
model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ==================== USERS ====================

model User {
  id         String  @id @default(uuid())
  email      String  @unique
  password   String
  firstName  String
  lastName   String
  middleName String?

  isActive Boolean   @default(true)
  isOnline Boolean   @default(false)
  lastSeen DateTime?

  // Роль пользователя (напрямую)
  roleId String?
  role   Role?  @relation(fields: [roleId], references: [id])

  // Профиль торгового
  tradeCode         String?   @unique
  firstTripDate     DateTime?
  isCoordinator     Boolean   @default(false)
  coordinatorId     String?
  coordinator       User?     @relation("CoordinatorSubordinates", fields: [coordinatorId], references: [id])
  subordinates      User[]    @relation("CoordinatorSubordinates")

  // Лимит одновременных сессий
  maxSessions Int @default(1)

  // Личные данные
  birthDate         DateTime?
  isMarried         Boolean?
  hasChildren       Boolean?
  hasPassport       Boolean?
  hasDriverLicense  Boolean?
  drivingExperience Float?
  comment           String?   @db.VarChar(500)
  passportNumber    String?
  registrationAddress String?
  livingAddress     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contacts            UserContact[]
  languages           UserLanguage[]
  citizenships        UserCitizenship[]
  documents           UserDocument[]
  sessions            Session[]
  auditLogs           AuditLog[]

  // Trip relations
  tripsCoordinated       Trip[]             @relation("TripCoordinator")
  tripsCreated           Trip[]             @relation("TripCreatedBy")
  tripCrewMembers        TripCrew[]
  presentationsCoordinated Presentation[]   @relation("PresentationCoordinator")
  presentationsCreated     Presentation[]   @relation("PresentationCreatedBy")
  presentationCrewMembers  PresentationCrew[]
  presentationSummaryRows  PresentationSummary[]

  // Warehouse relations
  personalWarehouses  Warehouse[]   @relation("PersonalWarehouse")
  warehousesCreated   Warehouse[]   @relation("WarehouseCreator")
  transactions        Transaction[]

  @@map("users")
}

// ==================== USER CONTACTS ====================

enum ContactType {
  MOBILE
  WHATSAPP
  TELEGRAM
}

model UserContact {
  id          String      @id @default(uuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        ContactType
  countryCode String      // "+998", "+7"
  phone       String      // номер без кода страны
  createdAt   DateTime    @default(now())

  @@map("user_contacts")
}

// ==================== USER LANGUAGES ====================

enum LanguageLevel {
  BEGINNER
  ELEMENTARY
  INTERMEDIATE
  UPPER_INTERMEDIATE
  ADVANCED
  NATIVE
}

model UserLanguage {
  id       String        @id @default(uuid())
  userId   String
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  language String
  level    LanguageLevel

  @@unique([userId, language])
  @@map("user_languages")
}

// ==================== USER CITIZENSHIPS ====================

model UserCitizenship {
  id      String @id @default(uuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  country String

  @@unique([userId, country])
  @@map("user_citizenships")
}

// ==================== DOCUMENTS ====================

model UserDocument {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  fileName    String
  filePath    String
  fileSize    Int
  mimeType    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("user_documents")
}

// ==================== SESSIONS ====================

model Session {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken String   @unique
  rememberMe   Boolean  @default(false)
  ip           String?
  userAgent    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@map("sessions")
}

// ==================== TRIPS ====================

enum TripStatus {
  PLANNED
  ACTIVE
  CLOSED
}

enum PresentationStatus {
  PLANNED
  COMPLETED
  CANCELLED
}

enum TripRole {
  LEADER
  MV
  GA
  MV_GA
  TRADER
}

model Trip {
  id              String     @id @default(uuid())
  name            String     // "AA250226" — авто: teamName + format(startDate)
  teamName        String     // название команды, напр. "AA"
  startDate       DateTime
  endDate         DateTime
  status          TripStatus @default(PLANNED)

  coordinatorId   String?
  coordinator     User?      @relation("TripCoordinator", fields: [coordinatorId], references: [id])

  createdById     String
  createdBy       User       @relation("TripCreatedBy", fields: [createdById], references: [id])

  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  crew            TripCrew[]
  presentations   Presentation[]
  warehouse       Warehouse?
  wallet          Wallet?

  @@map("trips")
}

model TripCrew {
  id      String   @id @default(uuid())
  tripId  String
  trip    Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  userId  String
  user    User     @relation(fields: [userId], references: [id])
  role    TripRole

  @@unique([tripId, userId])
  @@map("trip_crew")
}

// ==================== PRESENTATIONS ====================

model Presentation {
  id              String             @id @default(uuid())
  tripId          String
  trip            Trip               @relation(fields: [tripId], references: [id], onDelete: Cascade)
  name            String             // авто: "AA 23.02 #1"
  date            DateTime
  time            String             // "08:00"
  number          Int                // 1 / 2 / 3 по слоту времени
  status          PresentationStatus @default(PLANNED)

  typeId          String?
  type            PresentationType?  @relation(fields: [typeId], references: [id])

  venueId         String?
  venue           Venue?             @relation(fields: [venueId], references: [id])

  coordinatorId   String?
  coordinator     User?              @relation("PresentationCoordinator", fields: [coordinatorId], references: [id])

  createdById     String?
  createdBy       User?              @relation("PresentationCreatedBy", fields: [createdById], references: [id])

  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  crew            PresentationCrew[]
  summaryRows     PresentationSummary[]

  @@map("presentations")
}

model PresentationCrew {
  id              String       @id @default(uuid())
  presentationId  String
  presentation    Presentation @relation(fields: [presentationId], references: [id], onDelete: Cascade)
  userId          String
  user            User         @relation(fields: [userId], references: [id])
  role            TripRole

  @@unique([presentationId, userId])
  @@map("presentation_crew")
}

model PresentationSummary {
  id             String       @id @default(uuid())
  presentationId String
  presentation   Presentation @relation(fields: [presentationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id])

  successApproach Int? // Успешных Часовка
  totalApproach   Int? // Всех (каждых) Часовка
  refusalCount    Int? // Количество отказов
  refusalValue    Int? // Значение отказа
  rewriteCount    Int? // Количество переписанных
  rewriteValue    Int? // Ценность переписанных

  updatedAt DateTime @updatedAt

  @@unique([presentationId, userId])
  @@map("presentation_summary")
}

// ==================== DIRECTORIES ====================

model PresentationType {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())

  presentations Presentation[]

  @@map("presentation_types")
}

model Venue {
  id        String   @id @default(uuid())
  city      String
  address   String
  venueName String
  createdAt DateTime @default(now())

  presentations Presentation[]

  @@unique([city, address, venueName])
  @@map("venues")
}

// ==================== WAREHOUSE & WALLET ====================

enum WarehouseType {
  CENTRAL
  PERSONAL
  TRIP
}

enum TransactionType {
  INCOMING
  SALE
  GIFT
  CONTRACT
  WRITE_OFF
  TRANSFER_OUT
  TRANSFER_IN
}

model Warehouse {
  id          String        @id @default(uuid())
  name        String
  type        WarehouseType
  tripId      String?       @unique
  ownerId     String?
  createdById String
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())

  trip        Trip?         @relation(fields: [tripId], references: [id], onDelete: Cascade)
  owner       User?         @relation("PersonalWarehouse", fields: [ownerId], references: [id])
  createdBy   User          @relation("WarehouseCreator", fields: [createdById], references: [id])
  stock       Stock[]
  outgoing    Transaction[] @relation("FromWarehouse")
  incoming    Transaction[] @relation("ToWarehouse")

  @@map("warehouses")
}

model Product {
  id        String   @id @default(uuid())
  name      String
  unit      String
  sku       String?  @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  stock            Stock[]
  transactionItems TransactionItem[]

  @@map("products")
}

model Stock {
  id          String    @id @default(uuid())
  warehouseId String
  productId   String
  quantity    Decimal   @default(0) @db.Decimal(12, 3)

  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id])

  @@unique([warehouseId, productId])
  @@map("stock")
}

model Transaction {
  id              String          @id @default(uuid())
  type            TransactionType
  fromWarehouseId String?
  toWarehouseId   String?
  note            String?
  pairId          String?
  createdById     String
  createdAt       DateTime        @default(now())

  fromWarehouse   Warehouse?      @relation("FromWarehouse", fields: [fromWarehouseId], references: [id])
  toWarehouse     Warehouse?      @relation("ToWarehouse", fields: [toWarehouseId], references: [id])
  createdBy       User            @relation(fields: [createdById], references: [id])
  items           TransactionItem[]

  @@index([fromWarehouseId])
  @@index([toWarehouseId])
  @@index([pairId])
  @@index([createdAt])
  @@map("transactions")
}

model TransactionItem {
  id            String      @id @default(uuid())
  transactionId String
  productId     String
  quantity      Decimal     @db.Decimal(12, 3)

  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  product       Product     @relation(fields: [productId], references: [id])

  @@map("transaction_items")
}

model Wallet {
  id     String @id @default(uuid())
  tripId String @unique
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("wallets")
}

// ==================== AUDIT LOG ====================

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String   // "user.created", "role.updated"
  entity    String   // "user", "role", "permission"
  entityId  String?
  details   Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}
